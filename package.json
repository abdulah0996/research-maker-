{
  "name": "researchmaker",
  "version": "1.0.0",
  "description": "ResearchMaker public website and owner CMS",
  "scripts": {
    "test": "node --test",
    "dev": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/ssr",
    "check": "tsc --noEmit",
    "admin:reset": "node --env-file-if-exists=.env server/index.mjs --reset-admin"
  },
  "type": "module",
  "dependencies": {
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "framer-motion": "^14.14.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.78.0",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
