# Copy to .env for local development. Keep real values out of source control.
PORT=5173
HOST=127.0.0.1
SITE_URL=https://researchmaker.co.uk

# Atlas connection string with the application database name after the final slash.
# MONGODB_URI=
# Use these temporarily to provision or reset the owner account.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# International digits, including country code.
WHATSAPP_NUMBER=447577329727
# CONTACT_EMAIL=
# Optional owner email notifications for enquiries. The sender must be verified with Resend.
# RESEND_API_KEY=
# ENQUIRY_NOTIFY_FROM=
# ENQUIRY_NOTIFY_TO=
# Configure only for a known number of trusted reverse proxies.
# TRUST_PROXY_HOPS=1
